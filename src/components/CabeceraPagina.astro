---
// Ruta: src/components/CabeceraPagina.astro
// Cabecera común de las herramientas y páginas de datos: migas, H1 y entradilla.
import Breadcrumbs, { type Crumb } from './Breadcrumbs.astro';

interface Props {
  titulo: string;
  breadcrumbs: Crumb[];
  /** Etiqueta pequeña sobre el H1 («Herramienta», «Datos oficiales»…). */
  etiqueta?: string;
}

const { titulo, breadcrumbs, etiqueta } = Astro.props;
---

<section class="border-b border-slate-200 bg-gradient-to-b from-teal-50 to-white">
  <div class="mx-auto max-w-6xl px-4 pb-8 pt-6 sm:px-6 sm:pb-10">
    <Breadcrumbs items={breadcrumbs} />
    {etiqueta && <p class="mt-6 text-sm font-semibold uppercase tracking-wide text-teal-700">{etiqueta}</p>}
    <h1 class:list={['max-w-3xl text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl', etiqueta ? 'mt-2' : 'mt-6']}>
      {titulo}
    </h1>
    <div class="mt-4 max-w-3xl text-lg leading-relaxed text-slate-600">
      <slot />
    </div>
  </div>
</section>
