---
// Ruta: src/components/Faq.astro
// Preguntas frecuentes desplegables con su JSON-LD FAQPage.
interface Props {
  preguntas: { q: string; a: string }[];
  titulo?: string;
}
const { preguntas, titulo = 'Preguntas frecuentes' } = Astro.props;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: preguntas.map((p) => ({ '@type': 'Question', name: p.q, acceptedAnswer: { '@type': 'Answer', text: p.a } })),
};
---

<section aria-labelledby="titulo-faq" class="max-w-3xl">
  <h2 id="titulo-faq" class="text-2xl font-bold tracking-tight text-slate-900">{titulo}</h2>
  <div class="mt-6 divide-y divide-slate-200 rounded-2xl border border-slate-200 bg-white">
    {
      preguntas.map((p) => (
        <details class="group p-5 [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex cursor-pointer items-start justify-between gap-4 font-semibold text-slate-900">
            {p.q}
            <span class="mt-1 text-teal-700 transition group-open:rotate-45" aria-hidden="true">
              +
            </span>
          </summary>
          <p class="mt-3 leading-relaxed text-slate-600">{p.a}</p>
        </details>
      ))
    }
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</section>
