---
// Ruta: src/components/Herramientas.astro
// Rejilla con las herramientas de la web (menos la página actual).
import Icono from './Icono.astro';
import { HERRAMIENTAS, stripBase } from '../config/site';

interface Props {
  titulo?: string;
  /** Rutas que no se muestran (además de la actual). */
  excluir?: string[];
}
const { titulo = 'Más herramientas', excluir = [] } = Astro.props;
const actual = stripBase(Astro.url.pathname).replace(/\.html$/, '').replace(/\/index$/, '') || '/';
const lista = HERRAMIENTAS.filter((h) => h.href !== actual && !excluir.includes(h.href));
---

<section aria-labelledby="titulo-herramientas">
  <h2 id="titulo-herramientas" class="text-2xl font-bold tracking-tight text-slate-900">{titulo}</h2>
  <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {
      lista.map((h) => (
        <li>
          <a
            href={h.href}
            class="group flex h-full gap-4 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition hover:border-teal-300 hover:shadow-md"
          >
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-teal-50 text-teal-700 group-hover:bg-teal-100">
              <Icono nombre={h.icono} />
            </span>
            <span>
              <span class="block font-semibold text-slate-900 group-hover:text-teal-800">{h.titulo}</span>
              <span class="mt-1 block text-sm leading-relaxed text-slate-600">{h.texto}</span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</section>
