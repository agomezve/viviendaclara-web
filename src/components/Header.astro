---
// Ruta: src/components/Header.astro
import { NAV_LINKS, stripBase } from '../config/site';

const currentPath = stripBase(Astro.url.pathname).replace(/\.html$/, '').replace(/\/index$/, '') || '/';
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath === href || currentPath.startsWith(`${href}/`);
---

<header class="sticky top-0 z-40 border-b border-slate-200 bg-white/95 text-slate-900 backdrop-blur">
  <a
    href="#contenido"
    class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-3 focus:z-50 focus:rounded-md focus:bg-slate-900 focus:px-3 focus:py-2 focus:text-white"
  >
    Saltar al contenido
  </a>

  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6">
    <a href="/" class="flex items-center gap-2 text-lg font-bold tracking-tight">
      <img src="/favicon.svg" alt="" width="32" height="32" class="h-8 w-8" />
      <span>Vivienda<span class="text-teal-700">Clara</span></span>
    </a>

    <!-- Navegación de escritorio -->
    <nav aria-label="Principal" class="hidden items-center gap-1 md:flex">
      {
        NAV_LINKS.map((link) => (
          <a
            href={link.href}
            aria-current={isActive(link.href) ? 'page' : undefined}
            class:list={[
              'rounded-md px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100 hover:text-slate-900',
              isActive(link.href) && 'bg-teal-50 text-teal-800',
            ]}
          >
            {link.title}
          </a>
        ))
      }
    </nav>

    <!-- Botón de menú móvil -->
    <button
      type="button"
      class="inline-flex items-center justify-center rounded-md p-2 hover:bg-slate-100 md:hidden"
      aria-expanded="false"
      aria-controls="menu-movil"
      aria-label="Abrir menú"
      data-mobile-button
    >
      <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>
  </div>

  <!-- Menú móvil -->
  <nav id="menu-movil" aria-label="Principal móvil" class="hidden border-t border-slate-200 bg-white md:hidden" data-mobile-menu>
    <ul class="mx-auto max-w-6xl space-y-1 px-4 py-4">
      {
        NAV_LINKS.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={isActive(link.href) ? 'page' : undefined}
              class="block rounded-md px-3 py-2 text-base hover:bg-slate-100"
            >
              {link.title}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-mobile-button]');
  const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');
  if (button && menu) {
    const setOpen = (open: boolean) => {
      button.setAttribute('aria-expanded', String(open));
      button.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
      menu.classList.toggle('hidden', !open);
    };
    button.addEventListener('click', () => setOpen(button.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && button.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        button.focus();
      }
    });
    window.matchMedia('(min-width: 768px)').addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
    });
  }
</script>
