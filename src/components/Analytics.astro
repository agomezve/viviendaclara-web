---
// Ruta: src/components/Analytics.astro
// Google Analytics 4 con Consent Mode v2. Solo se carga si GA4_ID tiene un id válido ("G-…").
// Todo empieza denegado; la CMP certificada de Google (AdSense > Privacidad y mensajes)
// actualiza el consentimiento cuando el visitante elige. No hay banner propio.
import { GA4_ID, isAnalyticsEnabled } from '../config/site';

const id = GA4_ID.trim();
const consentDefaults = `
window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
gtag('consent', 'default', {
  ad_storage: 'denied',
  ad_user_data: 'denied',
  ad_personalization: 'denied',
  analytics_storage: 'denied',
  functionality_storage: 'denied',
  personalization_storage: 'denied',
  security_storage: 'granted',
  wait_for_update: 500
});
gtag('js', new Date());
gtag('config', ${JSON.stringify(id)});
`;
---

{
  isAnalyticsEnabled() && (
    <>
      <script is:inline set:html={consentDefaults} />
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(id)}`} />
    </>
  )
}
