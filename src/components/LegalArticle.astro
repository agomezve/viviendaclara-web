---
// Ruta: src/components/LegalArticle.astro
// Maquetación común de las páginas legales y corporativas (se usa dentro de BaseLayout):
// migas, título, fecha de revisión, índice opcional y contenido con estilos de prosa.
import Breadcrumbs from './Breadcrumbs.astro';

export interface TocItem {
  id: string;
  title: string;
}

interface Props {
  title: string;
  lead?: string;
  updated?: string;
  toc?: TocItem[];
}

const { title, lead, updated, toc = [] } = Astro.props;
---

<div class="mx-auto max-w-3xl px-4 py-8 sm:px-6 lg:py-12">
  <Breadcrumbs items={[{ name: title }]} />

  <article class="mt-6 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-10">
    <header class="border-b border-slate-200 pb-6">
      <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">{title}</h1>
      {lead && <p class="mt-3 text-lg leading-relaxed text-slate-600">{lead}</p>}
      {updated && <p class="mt-3 text-sm text-slate-500">Última actualización: {updated}</p>}
    </header>

    <slot name="before" />

    {
      toc.length > 0 && (
        <nav aria-labelledby="indice" class="mt-6 rounded-xl bg-slate-50 p-5">
          <p id="indice" class="text-sm font-semibold text-slate-900">
            Contenido
          </p>
          <ol class="mt-3 list-decimal space-y-1.5 pl-5 text-sm text-slate-700 marker:text-slate-400">
            {toc.map((item) => (
              <li>
                <a href={`#${item.id}`} class="hover:text-teal-700 hover:underline">
                  {item.title}
                </a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }

    <div class="article-body prose prose-slate mt-6 max-w-none prose-a:text-teal-700">
      <slot />
    </div>
  </article>
</div>
