---
// Ruta: src/components/PrecioHabitaciones.astro
// Precio medio de las habitaciones según los informes de Fotocasa e idealista.
// En un municipio: su cifra (o la de la comunidad si no sale). En una provincia: la comunidad y sus municipios.
import { HABITACIONES, MUNICIPIOS, comunidad, precioHabitacion } from '../lib/datos';
import { euros, porcentaje } from '../lib/calculos';

interface Props {
  ccaa: string;
  /** Código INE del municipio (ficha de municipio). */
  ine?: string;
  /** Código de la provincia (ficha de provincia). */
  provincia?: string;
}

const { ccaa, ine, provincia } = Astro.props;
const fc = HABITACIONES.fotocasa;
const id = HABITACIONES.idealista;
const precios = ine ? precioHabitacion(ine, ccaa) : [];
const delMunicipio = precios.filter((p) => p.ambito === 'municipio');
const cc = fc.ccaa[ccaa];
const nombreCcaa = comunidad(ccaa)?.nombre;
const fm = ine ? fc.municipios[ine] : undefined;
const municipiosProvincia = provincia
  ? MUNICIPIOS.filter((m) => m.provincia === provincia && fc.municipios[m.ine])
      .map((m) => ({ slug: m.slug, nombre: m.nombre, mes: fc.municipios[m.ine].mes }))
      .sort((a, b) => b.mes - a.mes)
  : [];
const hayAlgo = delMunicipio.length > 0 || cc;
---

{
  hayAlgo && (
    <div class="mt-4 rounded-2xl bg-teal-50 p-5">
      {delMunicipio.length > 0 ? (
        <div class="flex flex-wrap gap-6">
          {delMunicipio.map((p) => (
            <p>
              <span class="block text-3xl font-extrabold tracking-tight text-teal-800 tabular-nums">{euros(p.mes)}</span>
              <span class="block text-sm text-teal-900">al mes según {p.fuente} ({p.periodo})</span>
            </p>
          ))}
        </div>
      ) : (
        <p>
          <span class="block text-3xl font-extrabold tracking-tight text-teal-800 tabular-nums">{euros(cc!.mes)}</span>
          <span class="block text-sm text-teal-900">al mes de media en {nombreCcaa} según Fotocasa ({fc.periodo})</span>
        </p>
      )}
      <p class="mt-3 text-sm text-slate-700">
        {fm?.variacion != null && <>Hace un año, en {fc.periodoAnterior}, Fotocasa daba {euros(fm.anterior)} ({fm.variacion > 0 ? '+' : ''}{porcentaje(fm.variacion)}). </>}
        {delMunicipio.length > 0 && cc && <>La media de la comunidad ({nombreCcaa}) es de {euros(cc.mes)} y la de España, de {euros(fc.espana.mes)}. </>}
        {delMunicipio.length === 0 && ine && <>Los informes no dan una cifra propia de este municipio, así que te damos la de la comunidad. </>}
        {provincia && <>La media de España es de {euros(fc.espana.mes)}. </>}
        Son los precios que piden los anuncios, no lo que se firma al final.
      </p>
      {
        municipiosProvincia.length > 0 && (
          <ul class="mt-3 grid gap-1 text-sm sm:grid-cols-2">
            {municipiosProvincia.map((m) => (
              <li>
                <a href={`/vivienda/${m.slug}`} class="font-semibold text-teal-700 hover:underline">{m.nombre}</a>: {euros(m.mes)}/mes
              </li>
            ))}
          </ul>
        )
      }
      <p class="fuente mt-3">
        Fuentes: <a href={fc.url} rel="noopener" target="_blank">Fotocasa, «{fc.estudio}»</a>
        {delMunicipio.some((p) => p.fuente === 'idealista') && (
          <> e <a href={id.url} rel="noopener" target="_blank">informe de habitaciones de idealista ({id.periodo})</a></>
        )}. Más datos en la <a href="/guias/alquilar-habitacion#precios">guía para alquilar una habitación</a>.
      </p>
    </div>
  )
}
