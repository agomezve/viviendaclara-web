---
// Ruta: src/pages/alquilar-o-comprar.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import CabeceraPagina from '../components/CabeceraPagina.astro';
import SelectorComunidad from '../components/SelectorComunidad.astro';
import Herramientas from '../components/Herramientas.astro';
import AdSlot from '../components/AdSlot.astro';
import Faq from '../components/Faq.astro';
import Autor from '../components/Autor.astro';
import { EURIBOR, FUENTES, IMPUESTOS, MUNICIPIOS, SUPERFICIE_REFERENCIA, provincia, mesLegible } from '../lib/datos';
import { porcentaje } from '../lib/calculos';

const titulo = '¿Me compensa más alquilar o comprar?';
const breadcrumbs = [{ name: 'Herramientas', href: '/herramientas' }, { name: '¿Alquilar o comprar?' }];
const datos = {
  impuestos: IMPUESTOS.comunidades,
  iva: IMPUESTOS.ivaViviendaNueva,
  superficie: SUPERFICIE_REFERENCIA,
  ciudades: MUNICIPIOS.map((m) => ({ s: m.slug, n: m.nombre, p: provincia(m.provincia).nombre, c: m.ccaa, am: m.alquiler?.mes ?? null, cm2: m.compra.m2 })),
};

const preguntas = [
  {
    q: '¿Cómo compara la calculadora?',
    a: 'Suma lo que pagas cada año en los dos casos. El dinero que no gastas (la entrada y los impuestos si alquilas, o la diferencia de cada año) se supone invertido a la rentabilidad que pongas. Al final compara tu patrimonio: el piso menos lo que debes al banco si compras, o tus ahorros si alquilas.',
  },
  {
    q: '¿Qué pongo en revalorización y subida del alquiler?',
    a: `Nadie sabe cuánto subirán los precios. Por eso empiezan en 0 % y puedes probar varios escenarios. Como referencia, el valor tasado medio de la vivienda en España subió un ${porcentaje(FUENTES.compra.nacional.variacionAnual)} en el último año según el Ministerio de Vivienda, pero eso no garantiza lo que pase en los próximos.`,
  },
  {
    q: '¿Qué no tiene en cuenta?',
    a: 'Los gastos de vender el piso, las deducciones fiscales, los cambios de interés en una hipoteca variable y la inflación. Es una comparación orientativa para que veas qué variables pesan más en tu caso.',
  },
];
---

<BaseLayout
  title="¿Alquilar o comprar? Calculadora con tus números"
  heading={titulo}
  description="Compara cuánto pagas y cuánto patrimonio tienes al final si alquilas o si compras, con tu hipoteca, los impuestos de tu comunidad y tus propios supuestos."
  breadcrumbs={breadcrumbs}
>
  <CabeceraPagina titulo={titulo} breadcrumbs={breadcrumbs} etiqueta="Calculadora">
    <p>Pon tu alquiler, el piso que te comprarías y los años que piensas quedarte. Compara con quién acabas con más patrimonio y cuánto dinero se va en cada caso.</p>
  </CabeceraPagina>

  <div class="mx-auto max-w-6xl space-y-14 px-4 py-10 sm:px-6" data-aoc>
    <div class="grid gap-6 lg:grid-cols-[1fr_1.1fr]">
      <form class="tarjeta space-y-5" novalidate>
        <div class="relative rounded-xl bg-slate-50 p-4">
          <label for="ciudad" class="etiqueta">Rellenar con los datos de una ciudad (opcional)</label>
          <input id="ciudad" type="text" class="entrada" placeholder="Escribe tu ciudad" spellcheck="false" data-ciudad />
          <ul data-sugerencias hidden class="absolute inset-x-4 top-full z-30 -mt-2 max-h-72 overflow-auto rounded-xl border border-slate-200 bg-white shadow-xl"></ul>
          <span class="ayuda">Pone el alquiler mediano y el precio de un piso de {SUPERFICIE_REFERENCIA} m² de esa ciudad. Luego puedes cambiarlos.</span>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label for="alquiler" class="etiqueta">Alquiler al mes</label>
            <div class="con-sufijo"><input id="alquiler" name="alquiler" type="number" min="0" step="any" class="entrada" placeholder="Ej.: 900" /><span class="sufijo">€/mes</span></div>
          </div>
          <div>
            <label for="precio" class="etiqueta">Precio del piso</label>
            <div class="con-sufijo"><input id="precio" name="precio" type="number" min="0" step="any" class="entrada" placeholder="Ej.: 220000" /><span class="sufijo">€</span></div>
          </div>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label for="ccaa" class="etiqueta">Comunidad (impuestos)</label>
            <SelectorComunidad />
          </div>
          <div>
            <label for="anios" class="etiqueta">Años que te quedarías</label>
            <div class="con-sufijo"><input id="anios" name="anios" type="number" min="1" max="40" step="1" class="entrada" value="10" /><span class="sufijo">años</span></div>
          </div>
        </div>

        <fieldset class="grid gap-4 border-t border-slate-200 pt-5 sm:grid-cols-3">
          <legend class="mb-3 text-base font-bold text-slate-900">Hipoteca</legend>
          <div>
            <label for="entrada" class="etiqueta">Entrada</label>
            <div class="con-sufijo"><input id="entrada" name="entrada" type="number" min="0" max="100" step="1" class="entrada" value="20" /><span class="sufijo">%</span></div>
          </div>
          <div>
            <label for="interes" class="etiqueta">Interés</label>
            <div class="con-sufijo"><input id="interes" name="interes" type="number" min="0" step="0.01" class="entrada" value={EURIBOR.valor} /><span class="sufijo">%</span></div>
          </div>
          <div>
            <label for="plazo" class="etiqueta">Plazo</label>
            <div class="con-sufijo"><input id="plazo" name="plazo" type="number" min="1" max="40" step="1" class="entrada" value="30" /><span class="sufijo">años</span></div>
          </div>
          <span class="ayuda sm:col-span-3">El interés empieza con el Euríbor de {mesLegible(EURIBOR.mes)} sin diferencial: pon el de tu oferta.</span>
        </fieldset>

        <fieldset class="grid gap-4 border-t border-slate-200 pt-5 sm:grid-cols-2">
          <legend class="mb-3 text-base font-bold text-slate-900">Gastos que solo paga el propietario</legend>
          <div>
            <label for="otros" class="etiqueta">Notaría, registro, gestoría…</label>
            <div class="con-sufijo"><input id="otros" name="otros" type="number" min="0" step="any" class="entrada" placeholder="0" /><span class="sufijo">€</span></div>
          </div>
          <div>
            <label for="anuales" class="etiqueta">IBI, comunidad, seguro y arreglos</label>
            <div class="con-sufijo"><input id="anuales" name="anuales" type="number" min="0" step="any" class="entrada" placeholder="0" /><span class="sufijo">€/año</span></div>
          </div>
          <span class="ayuda sm:col-span-2">Los impuestos de compra (ITP de vivienda usada) se calculan solos con tu comunidad.</span>
        </fieldset>

        <fieldset class="grid gap-4 border-t border-slate-200 pt-5 sm:grid-cols-3">
          <legend class="mb-1 text-base font-bold text-slate-900">Tus supuestos para el futuro</legend>
          <p class="ayuda sm:col-span-3 mt-0 mb-2">Nadie los sabe. Empiezan en 0 %: prueba varios.</p>
          <div>
            <label for="revalorizacion" class="etiqueta">El piso sube al año</label>
            <div class="con-sufijo"><input id="revalorizacion" name="revalorizacion" type="number" step="0.1" class="entrada" value="0" /><span class="sufijo">%</span></div>
          </div>
          <div>
            <label for="subida" class="etiqueta">El alquiler sube al año</label>
            <div class="con-sufijo"><input id="subida" name="subida" type="number" step="0.1" class="entrada" value="0" /><span class="sufijo">%</span></div>
          </div>
          <div>
            <label for="rentabilidad" class="etiqueta">Tus ahorros rinden</label>
            <div class="con-sufijo"><input id="rentabilidad" name="rentabilidad" type="number" step="0.1" class="entrada" value="0" /><span class="sufijo">%</span></div>
          </div>
        </fieldset>
      </form>

      <div class="space-y-4" aria-live="polite">
        <div data-vacio class="tarjeta text-slate-600">Pon el alquiler y el precio del piso para comparar.</div>
        <section data-res hidden class="tarjeta">
          <p data-veredicto class="rounded-2xl p-5 text-lg font-bold"></p>
          <div class="mt-4 grid grid-cols-2 gap-3">
            <p class="dato"><span class="dato-nombre">Patrimonio si compras</span><span data-pat-comprar class="dato-valor text-xl"></span></p>
            <p class="dato"><span class="dato-nombre">Patrimonio si alquilas</span><span data-pat-alquilar class="dato-valor text-xl"></span></p>
          </div>
          <h3 class="mt-6 font-semibold text-slate-900">Dinero que no recuperas</h3>
          <dl class="mt-2 divide-y divide-slate-100 text-sm" data-perdido></dl>
          <p class="fuente mt-4">Patrimonio al final: si compras, lo que vale el piso menos lo que debes al banco, más lo que ahorres los años en que comprar te sale más barato; si alquilas, lo que no pusiste en la compra más lo que ahorres cada año, invertido a la rentabilidad que pongas.</p>
        </section>
      </div>
    </div>

    <AdSlot format="horizontal" />
    <Faq preguntas={preguntas} />
    <Herramientas />
    <Autor />
  </div>
  <script type="application/json" id="datos-aoc" set:html={JSON.stringify(datos)} />
</BaseLayout>

<script>
  import { euros, cuotaHipoteca, tablaAmortizacion, impuestosCompra, type ImpuestosComunidad } from '../lib/calculos';
  import { conectaLugar, leeDatos, numero } from '../scripts/lugar';

  interface Ciudad {
    s: string;
    n: string;
    p: string;
    c: string;
    am: number | null;
    cm2: number | null;
  }
  const raiz = document.querySelector<HTMLElement>('[data-aoc]')!;
  const form = raiz.querySelector('form')!;
  const d = leeDatos<{ impuestos: Record<string, ImpuestosComunidad>; iva: number; superficie: number; ciudades: Ciudad[] }>('datos-aoc');
  const $ = <T extends HTMLElement>(s: string) => raiz.querySelector<T>(s)!;
  const campo = (n: string) => form.querySelector<HTMLInputElement>(`[name="${n}"]`)!;
  const val = (n: string) => numero(campo(n));

  conectaLugar(
    $<HTMLInputElement>('[data-ciudad]'),
    $<HTMLUListElement>('[data-sugerencias]'),
    d.ciudades.map((c) => ({ clave: c.s, nombre: c.n, detalle: c.p })),
    (o) => {
      const c = o && d.ciudades.find((x) => x.s === o.clave);
      if (!c) return;
      if (c.am) campo('alquiler').value = String(c.am);
      if (c.cm2) campo('precio').value = String(Math.round((c.cm2 * d.superficie) / 1000) * 1000);
      (form.querySelector('[name="ccaa"]') as HTMLSelectElement).value = c.c;
      calcula();
    },
  );

  function fila(nombre: string, valor: string) {
    const div = document.createElement('div');
    div.className = 'flex justify-between gap-4 py-2';
    const dt = document.createElement('dt');
    dt.className = 'text-slate-600';
    dt.textContent = nombre;
    const dd = document.createElement('dd');
    dd.className = 'font-semibold tabular-nums whitespace-nowrap';
    dd.textContent = valor;
    div.append(dt, dd);
    return div;
  }

  function calcula() {
    const alquiler = val('alquiler');
    const precio = val('precio');
    const hay = alquiler > 0 && precio > 0;
    $('[data-vacio]').hidden = hay;
    $('[data-res]').hidden = !hay;
    if (!hay) return;

    const anios = Math.max(1, Math.round(val('anios') || 10));
    const entradaPct = Math.min(100, Math.max(0, val('entrada') || 0));
    const interes = val('interes') || 0;
    const plazo = Math.max(1, Math.round(val('plazo') || 30));
    const otros = val('otros') || 0;
    const anuales = val('anuales') || 0;
    const rev = (val('revalorizacion') || 0) / 100;
    const sub = (val('subida') || 0) / 100;
    const rent = (val('rentabilidad') || 0) / 100;
    const ccaa = d.impuestos[(form.querySelector('[name="ccaa"]') as HTMLSelectElement).value];
    const imp = impuestosCompra(precio, ccaa, false, d.iva);

    const capital = precio * (1 - entradaPct / 100);
    const cuota = cuotaHipoteca(capital, interes, plazo);
    const tabla = tablaAmortizacion(capital, interes, plazo);
    const inicial = precio - capital + imp.total + otros;

    let ahorroInquilino = inicial;
    let ahorroPropietario = 0;
    let alquilerPagado = 0;
    let intereses = 0;
    for (let a = 1; a <= anios; a++) {
      const costeAlquiler = alquiler * 12 * Math.pow(1 + sub, a - 1);
      const costeCompra = (a <= plazo ? cuota * 12 : 0) + anuales;
      alquilerPagado += costeAlquiler;
      intereses += tabla[a - 1]?.intereses ?? 0;
      ahorroInquilino = ahorroInquilino * (1 + rent) + Math.max(0, costeCompra - costeAlquiler);
      ahorroPropietario = ahorroPropietario * (1 + rent) + Math.max(0, costeAlquiler - costeCompra);
    }
    const deuda = anios >= plazo ? 0 : tabla[anios - 1].pendiente;
    const valorPiso = precio * Math.pow(1 + rev, anios);
    const patComprar = valorPiso - deuda + ahorroPropietario;
    const patAlquilar = ahorroInquilino;
    const diferencia = patComprar - patAlquilar;

    const ver = $('[data-veredicto]');
    ver.className = `rounded-2xl p-5 text-lg font-bold ${diferencia >= 0 ? 'bg-teal-50 text-teal-900' : 'bg-sky-50 text-sky-900'}`;
    ver.textContent =
      Math.abs(diferencia) < 1000
        ? `Con estos números, a ${anios} años sale prácticamente igual.`
        : diferencia > 0
          ? `Con estos números, a ${anios} años comprar te deja ${euros(diferencia)} más de patrimonio.`
          : `Con estos números, a ${anios} años alquilar te deja ${euros(-diferencia)} más de patrimonio.`;
    $('[data-pat-comprar]').textContent = euros(patComprar);
    $('[data-pat-alquilar]').textContent = euros(patAlquilar);
    $('[data-perdido]').replaceChildren(
      fila(`Si alquilas: alquiler de ${anios} años`, euros(alquilerPagado)),
      fila(`Si compras: intereses de ${anios} años`, euros(intereses)),
      fila('Si compras: impuestos de la compra', imp.desconocido ? 'Sin calcular' : euros(imp.total)),
      fila('Si compras: notaría y demás', euros(otros)),
      fila(`Si compras: gastos de ${anios} años (IBI, comunidad…)`, euros(anuales * anios)),
    );
  }

  form.addEventListener('input', (e) => {
    if ((e.target as HTMLElement).hasAttribute('data-ciudad')) return;
    calcula();
  });
  form.addEventListener('submit', (e) => e.preventDefault());
  calcula();
</script>
